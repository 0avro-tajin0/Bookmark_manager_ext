{
   "action": {
      "default_icon": {
         "128": "icon128.png",
         "16": "icon16.png",
         "32": "icon32.png",
         "48": "icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Quick Save"
   },
   "background": {
      "service_worker": "background.js"
   },
   "chrome_url_overrides": {
      "newtab": "newtab.html"
   },
   "commands": {
      "_execute_action": {
         "description": "Open Quick Save",
         "suggested_key": {
            "default": "Ctrl+Shift+P"
         }
      }
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "A personal new tab bookmark manager. Save bookmarks into boards, track focus, and start each day organized.",
   "host_permissions": [ "https://www.googleapis.com/*", "https://accounts.google.com/*", "https://*.gstatic.com/*", "https://icons.duckduckgo.com/*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "BlackCodex Bookmark Manager",
   "oauth2": {
      "client_id": "REPLACE_WITH_YOUR_OWN_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
      "scopes": [ "profile", "email" ]
   },
   "permissions": [ "storage", "unlimitedStorage", "bookmarks", "identity", "activeTab", "tabs", "search", "favicon" ],
   "version": "1.0.0"
}
